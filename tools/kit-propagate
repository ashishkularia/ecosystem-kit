#!/usr/bin/env python3
"""kit-propagate — kit changes flow to every project as PRs, automatically.

Owner ask (2026-07-29): "if we change anything in ecosystem-kit, all projects
pull it and update themselves." This tool is that — with the merge button
still the owner's. Cron runs it daily; for every registered repo whose
kit-version stamp is behind kit main, it produces ONE update PR:

    pull kit main → per repo: worktree off origin default branch
    → installer/update.sh (engine + skills + stamp; its never-touch
      contract is preserved)
    → policy patches (explicit, idempotent, listed below)
    → GATE: py_compile AND import-test every hook in the worktree —
      a repo with project-local engine additions (e.g. DevContainer's
      _constants extras) FAILS the gate and gets a logged skip, never
      a breaking PR
    → commit, safe-push branch, open PR via GitHub API (PAT from
      ~/.secrets/github-pat; no AI tokens spent)

POLICY PATCHES (kit-wide owner rules applied outside update.sh's scope):
  - attribution {commit:"", pr:"", sessionUrl:false} merged into
    .claude/settings.json when absent (owner rule 2026-07-29).
  - missing kit hook wiring appended to .claude/settings.json (ADDITIVE only:
    never removes, reorders, or touches project-local hooks). Without it a kit
    change that wires an existing hook onto a NEW event ships as dead code —
    the module updates but nothing calls it, because update.sh deliberately
    never rewrites project-owned settings.json.

Modes: run (default) | check (STRICTLY read-only — reports who is behind,
mutates nothing; a dry-run that consumes state is a bug, learned on the
comment poller).

Skips: the kit repo itself, repos without a kit install, repos whose
update branch already exists (pending PR), stamp-only diffs (noise).
"""
import json
import re
import subprocess
import time
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

KIT = Path("/home/ubuntu/ecosystem-kit")
REGISTRY = Path.home() / ".claude" / "repo-registry"
TOKEN_FILE = Path.home() / ".secrets" / "github-pat"
SAFE_PUSH = "/home/ubuntu/.claude/bin/safe-push"
DEPLOYED = Path.home() / ".claude" / "bin"
WORKTREES = Path("/home/ubuntu/worktrees")
LOG = Path.home() / ".claude" / "kit-propagate.log"
REMOTE_RE = re.compile(r"github\.com[:/]([^/]+)/([^/\s]+?)(?:\.git)?$")


def log(msg):
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(LOG, "a") as f:
        f.write(f"{stamp} {msg}\n")
    print(msg)


# Local git work is fast; anything touching the remote is not. On a link with
# a ~13s round-trip to github.com (measured 2026-08-27), safe-push — which
# fetches, checks the remote default branch, then pushes — blew the flat 300s
# budget on the largest repo and took the whole run down with a TimeoutExpired
# traceback, so the four repos after it were never attempted.
LOCAL_TIMEOUT = 300
NETWORK_TIMEOUT = 1200


def run(cmd, cwd=None, check=True, timeout=LOCAL_TIMEOUT):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            raise RuntimeError(f"{' '.join(cmd)} timed out after {timeout}s")
        return subprocess.CompletedProcess(cmd, 1, "", f"timed out after {timeout}s")
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} failed: {r.stderr.strip()[:300]}")
    return r


def repo_coords(path):
    r = run(["git", "-C", str(path), "remote", "get-url", "origin"], check=False)
    m = REMOTE_RE.search(r.stdout.strip())
    return (m.group(1), m.group(2)) if m else None


def default_branch(path):
    r = run(["git", "-C", str(path), "symbolic-ref", "refs/remotes/origin/HEAD"], check=False)
    if r.returncode == 0:
        return r.stdout.strip().rsplit("/", 1)[-1]
    for b in ("main", "master"):
        if run(["git", "-C", str(path), "rev-parse", "--verify", f"origin/{b}"], check=False).returncode == 0:
            return b
    return "main"


def recorded_kit_commit(repo, base=None):
    """The kit commit a repo records, read from origin/<base> when available.

    Reading .claude/kit-version out of the WORKING CHECKOUT reports whatever
    branch that checkout happens to be parked on. mylantite sat on a feature
    branch cut before its kit PR merged and reported itself behind by a commit
    it already had (2026-08-30). An update PR is cut from origin/<base>, so
    origin/<base> is what "behind" has to mean — the same reasoning the kit side
    already applies to itself ("the REMOTE default's tip — authoritative, never
    the local HEAD").

    Falls back to the checkout when the ref or the file is absent, so a repo
    that has never pushed a stamp still reports something.
    """
    text = None
    if base:
        r = run(["git", "-C", str(repo), "show", f"origin/{base}:.claude/kit-version"],
                check=False)
        if r.returncode == 0:
            text = r.stdout
    if text is None:
        kv = Path(repo) / ".claude" / "kit-version"
        if not kv.is_file():
            return None
        text = kv.read_text()
    m = re.search(r"kit commit ([0-9a-f]{6,40})", text)
    return m.group(1) if m else "unknown"


def warn_stale_deployment():
    """Advisory: the deployed copy of a machine tool differs from the kit.

    These tools run from ~/.claude/bin — cron included — not from the kit
    checkout, and only bootstrap-machine.sh copies them across. Three merged
    fixes to THIS FILE sat unused for days while cron executed the stale copy
    and reported success; the union-merge fix reaching zero repos had that as
    its second, independent cause (2026-08-30).

    Warn, never abort: a stale deployment is worth saying out loud and is never
    a reason to refuse to propagate.
    """
    src = KIT / "tools"
    if not src.is_dir() or not DEPLOYED.is_dir():
        return
    # The deploy list lives in bootstrap-machine.sh; parse it rather than keep a
    # second copy here that would drift. Falls back to "whatever is already
    # deployed" if the line ever moves, which still catches drift, just not a
    # tool that was never copied out.
    names = None
    boot = src / "bootstrap-machine.sh"
    if boot.is_file():
        m = re.search(r"for t in ([^;\n]+); do", boot.read_text())
        if m:
            names = [n for n in m.group(1).split() if n]
    if not names:
        names = [f.name for f in DEPLOYED.iterdir() if f.is_file()]

    stale, missing = [], []
    for n in names:
        f, d = src / n, DEPLOYED / n
        if not f.is_file():
            continue
        if not d.is_file():
            missing.append(n)
        else:
            try:
                if d.read_bytes() != f.read_bytes():
                    stale.append(n)
            except OSError:
                pass
    if stale or missing:
        bits = []
        if stale:
            bits.append(f"stale: {', '.join(sorted(stale))}")
        if missing:
            bits.append(f"never deployed: {', '.join(sorted(missing))}")
        log(f"[warn] ~/.claude/bin differs from the kit ({'; '.join(bits)}) — "
            f"cron runs the DEPLOYED copy, so these fixes are NOT live. "
            f"Refresh: bash {boot}")


def hooks_gate(wt):
    """py_compile + import-test every hook; True = safe to ship."""
    hooks_dir = Path(wt) / ".claude" / "hooks"
    for f in sorted(hooks_dir.glob("*.py")):
        c = run(["python3", "-m", "py_compile", str(f)], check=False)
        if c.returncode != 0:
            log(f"    GATE FAIL compile {f.name}: {c.stderr.strip()[:200]}")
            return False
        if not f.name.startswith("_"):
            i = run(["python3", "-c",
                     f"import sys; sys.path.insert(0, '{hooks_dir}'); import {f.stem}"],
                    check=False)
            if i.returncode != 0:
                log(f"    GATE FAIL import {f.name}: {i.stderr.strip()[:200]}")
                return False
    return True


def patch_gitattributes(wt):
    """Append the kit's union-merge lines to .gitattributes if missing.

    install.sh does this too, but it runs once per repo — every repo installed
    before this existed would never get it. The docs contract guarantees every
    substantive change touches CHANGELOG.md, and it is newest-first, so
    concurrent branches always insert at the same line and always conflict.

    Matches on the PATH only, so a repo that deliberately set its own driver for
    one of these keeps it rather than gaining a second contradictory line.
    """
    snippet = KIT / "templates" / "gitattributes.snippet"
    if not snippet.is_file():
        return []
    target = Path(wt) / ".gitattributes"
    existing = target.read_text().splitlines() if target.is_file() else []
    have = {ln.split()[0] for ln in existing if ln.strip() and not ln.startswith("#")}

    added = []
    for line in snippet.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        path_only = line.split()[0]
        if path_only not in have:
            existing.append(line)
            added.append(path_only)
    if not added:
        return [], set()
    target.write_text("\n".join(existing).rstrip("\n") + "\n")

    paths = {".gitattributes"}
    # A deny-by-default .gitignore ("*" on line 1, then an explicit "!" allowlist
    # — DevContainer is built this way) ignores the file we just wrote, so
    # `git add` REFUSES it and takes the whole repo down with a RuntimeError
    # (2026-08-30). Un-ignore it explicitly rather than reaching for `git add -f`:
    # the allowlist is the repo's stated intent, and a tracked-but-ignored file
    # is a trap for whoever edits it next.
    ignored = run(["git", "-C", str(wt), "check-ignore", "-q", "--", ".gitattributes"],
                  check=False)
    if ignored.returncode == 0:
        gi = Path(wt) / ".gitignore"
        lines = gi.read_text().splitlines() if gi.is_file() else []
        if "!.gitattributes" not in {ln.strip() for ln in lines}:
            lines.append("!.gitattributes")
            gi.write_text("\n".join(lines).rstrip("\n") + "\n")
            paths.add(".gitignore")
    return added, paths


def patch_attribution(wt):
    p = Path(wt) / ".claude" / "settings.json"
    if not p.is_file():
        return False
    d = json.loads(p.read_text())
    want = {"commit": "", "pr": "", "sessionUrl": False}
    if d.get("attribution") == want:
        return False
    d["attribution"] = want
    p.write_text(json.dumps(d, indent=2) + "\n")
    return True


def patch_hook_wiring(wt):
    """Add kit hook wirings the target's settings.json is missing.

    update.sh ships engine FILES but never rewrites settings.json (it is
    project-owned — homeassistant, for one, wires a project-local guard_lint_md
    there). So a kit change that wires an existing hook onto a NEW event
    reaches every repo as dead code: the module updates, nothing calls it. That
    is how the 2026-08-01 pre-commit diary gate would have silently not existed
    in any already-installed repo.

    Strictly ADDITIVE: appends a (event, matcher, hook) triple only when the
    template has it and the target does not. Never removes, never reorders,
    never touches a matcher group the template does not define — so
    project-local hooks and ordering survive untouched."""
    p = Path(wt) / ".claude" / "settings.json"
    tmpl = KIT / "templates" / "settings.json.template"
    if not p.is_file() or not tmpl.is_file():
        return []
    try:
        target = json.loads(p.read_text())
        want = json.loads(tmpl.read_text())
    except ValueError:
        return []

    def hook_name(cmd):
        return cmd.strip().split()[-1] if cmd.strip() else ""

    added = []
    t_hooks = target.setdefault("hooks", {})
    for event, groups in (want.get("hooks") or {}).items():
        t_groups = t_hooks.setdefault(event, [])
        for group in groups:
            matcher = group.get("matcher")
            dest = next((g for g in t_groups if g.get("matcher") == matcher), None)
            if dest is None:
                # A whole event/matcher group the target lacks: take it as-is.
                t_groups.append(json.loads(json.dumps(group)))
                added += [f"{event}[{matcher or '*'}]:{hook_name(h.get('command',''))}"
                          for h in group.get("hooks", [])]
                continue
            have = {hook_name(h.get("command", "")) for h in dest.setdefault("hooks", [])}
            for h in group.get("hooks", []):
                name = hook_name(h.get("command", ""))
                if name and name not in have:
                    dest["hooks"].append(json.loads(json.dumps(h)))
                    have.add(name)
                    added.append(f"{event}[{matcher or '*'}]:{name}")
    if added:
        p.write_text(json.dumps(target, indent=2) + "\n")
    return added


def create_pr(owner, repo, head, base, old, new, files):
    tok = TOKEN_FILE.read_text().strip()
    body = {
        "title": f"chore(kit): update from kit {old} -> {new}",
        "head": head, "base": base,
        "body": (f"Automated kit propagation ({old} -> {new}) by `kit-propagate`.\n\n"
                 f"Applied: `installer/update.sh` (engine + skills + stamp) + policy patches "
                 f"(attribution off). Gate passed: every hook compiles AND imports in this "
                 f"worktree.\n\nChanged:\n" + "\n".join(f"- {f}" for f in files) +
                 "\n\nMerge is yours; the next propagation run skips this repo while this PR's "
                 "branch exists."),
    }
    req = urllib.request.Request(
        f"https://api.github.com/repos/{owner}/{repo}/pulls",
        data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {tok}", "Accept": "application/vnd.github+json",
                 "User-Agent": "kit-propagate", "Content-Type": "application/json"},
        method="POST")
    # The branch is ALREADY pushed by the time we get here, so an exception
    # escaping this function is worse than it looks: the run dies leaving an
    # orphaned branch with no PR — and because the skip above matches on the
    # branch prefix, every later run then skips that repo as "pending" for a PR
    # that does not exist. Observed 2026-08-27: a transient RemoteDisconnected
    # mid-run left grade5 exactly there. Retry once, then surface the orphan
    # loudly instead of raising.
    last = None
    for attempt in (1, 2):
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.loads(r.read()).get("html_url", "?")
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:200]
            if 400 <= e.code < 500 and e.code != 429:
                raise RuntimeError(f"GitHub rejected the PR ({e.code}): {detail}")
            last = f"HTTP {e.code}: {detail}"
        except Exception as e:  # URLError, RemoteDisconnected, socket timeouts
            last = f"{type(e).__name__}: {e}"
        if attempt == 1:
            time.sleep(5)
    raise RuntimeError(
        f"branch {head} pushed but PR creation failed ({last}). "
        f"Open it by hand: gh pr create --repo {owner}/{repo} --head {head} --base {base} "
        f"— until then this repo is skipped as 'pending' for a PR that does not exist.")


def kit_default_branch():
    """The kit repo's default branch, from the remote — not the local checkout."""
    r = run(["git", "-C", str(KIT), "symbolic-ref", "-q", "--short",
             "refs/remotes/origin/HEAD"], check=False)
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip().split("/")[-1]
    for b in ("main", "master"):
        if run(["git", "-C", str(KIT), "rev-parse", "--verify", f"origin/{b}"],
               check=False).returncode == 0:
            return b
    return "main"


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "run"
    run(["git", "-C", str(KIT), "fetch", "-q", "origin"], check=False)
    kit_default = kit_default_branch()
    # kit_head is the REMOTE default's tip — authoritative, never the local HEAD.
    kit_head = run(["git", "-C", str(KIT), "rev-parse", "--short",
                    f"origin/{kit_default}"]).stdout.strip()
    if mode == "run":
        # update.sh copies engine files from the kit WORKING TREE, so a real run
        # must be ON the default branch AND synced to origin. A checkout parked on
        # a feature branch would ship unmerged engine files and stamp every repo
        # with an unmerged commit (this happened once — DevContainer #7). Refuse.
        cur = run(["git", "-C", str(KIT), "branch", "--show-current"]).stdout.strip()
        run(["git", "-C", str(KIT), "pull", "--ff-only", "-q"], check=False)
        head = run(["git", "-C", str(KIT), "rev-parse", "HEAD"]).stdout.strip()
        remote = run(["git", "-C", str(KIT), "rev-parse", f"origin/{kit_default}"]).stdout.strip()
        if cur != kit_default or head != remote:
            log(f"[abort] kit checkout is not on a synced '{kit_default}' "
                f"(on '{cur or 'DETACHED'}', HEAD {head[:7]} vs origin {remote[:7]}) — "
                f"refusing to propagate unmerged content. "
                f"Fix: git -C {KIT} checkout {kit_default} && git -C {KIT} pull --ff-only")
            return 1
    warn_stale_deployment()
    paths = [ln.split("#")[0].strip() for ln in REGISTRY.read_text().splitlines()
             if ln.split("#")[0].strip()] if REGISTRY.exists() else []

    for repo in paths:
        if Path(repo).resolve() == KIT.resolve():
            continue
        name = Path(repo).name
        base = default_branch(repo)
        # Fetch BEFORE the stamp read: the stamp now comes from origin/<base>,
        # so a stale remote-tracking ref would answer "behind" with yesterday's
        # state. `check` deliberately does NOT fetch — it is read-only and
        # reports what is known locally.
        #
        # --prune is load-bearing, not tidiness. The pending-branch skip below
        # reads LOCAL remote-tracking refs, and a plain fetch never deletes the
        # ref for a branch the remote dropped — which GitHub does on every PR
        # merge. Without pruning, a repo whose kit-update PR merged keeps a
        # stale refs/remotes/origin/chore/kit-update-* forever and is skipped
        # FOREVER: one kit update per repo, then silence.
        if mode == "run":
            run(["git", "-C", repo, "fetch", "-q", "--prune"], check=False,
                timeout=NETWORK_TIMEOUT)
        rec = recorded_kit_commit(repo, base)
        if rec is None:
            continue  # no kit install
        if rec == kit_head:
            print(f"[ok]   {name}: up to date ({kit_head})")
            continue
        if mode == "check":
            print(f"[behind] {name}: {rec} -> {kit_head} (would open PR)")
            continue

        branch = f"chore/kit-update-{kit_head}"
        # Skip while ANY kit-update branch is pending, not just this kit head's.
        # Keying the check on kit_head meant a single kit commit landing between
        # runs defeated it: the branch name changed, the open PR was invisible,
        # and the repo got a SECOND overlapping update PR (2026-08-27,
        # DevContainer, after gh landed on kit main mid-propagation).
        pending = run(["git", "-C", repo, "for-each-ref", "--format=%(refname:short)",
                       "refs/remotes/origin/chore/kit-update-*"], check=False)
        existing = [ln.strip() for ln in (pending.stdout or "").splitlines() if ln.strip()]
        if existing:
            print(f"[skip] {name}: kit update already pending ({existing[0]})")
            continue
        # Repo-relative paths outside .claude/ that policy patches modify. A
        # patch that writes anywhere else MUST add its path here or its work is
        # silently discarded.
        touched = set()
        wt = WORKTREES / f"{name}-kitup"
        run(["git", "-C", repo, "worktree", "remove", "--force", str(wt)], check=False)
        run(["git", "-C", repo, "branch", "-D", branch], check=False)
        try:
            run(["git", "-C", repo, "worktree", "add", "-b", branch, str(wt), f"origin/{base}"])
            up = run(["bash", str(KIT / "installer" / "update.sh"), str(wt)], check=False)
            if up.returncode != 0:
                log(f"[FAIL] {name}: update.sh: {up.stderr.strip()[:200]}"); continue
            patch_attribution(wt)
            wired = patch_hook_wiring(wt)
            if wired:
                log(f"[wire] {name}: added hook wiring {', '.join(wired)}")
            attrs, attr_paths = patch_gitattributes(wt)
            if attrs:
                touched |= attr_paths
                log(f"[attr] {name}: union merge for {', '.join(attrs)}"
                    + (" (un-ignored in .gitignore)" if ".gitignore" in attr_paths else ""))
            if not hooks_gate(wt):
                log(f"[FAIL] {name}: hook gate failed — project-local engine additions need a "
                    f"manual merge with the kit engine; NO PR opened")
                continue
            # Stage .claude/ AND whatever the policy patches touched outside it.
            # `git add .claude` alone silently dropped patch_gitattributes'
            # work: .gitattributes lives at the repo root, so it was written,
            # never staged, judged "no material changes", and deleted with the
            # worktree — the union-merge fix reaching zero repos while the run
            # reported [ok] (2026-08-29). Every earlier patch happened to write
            # inside .claude/, which is why the scope held until it did not.
            run(["git", "-C", str(wt), "add", ".claude", *sorted(touched)])
            changed = [l.split("\t")[-1] for l in
                       run(["git", "-C", str(wt), "diff", "--cached", "--name-only"]).stdout.splitlines()]
            if not changed or changed == [".claude/kit-version"]:
                print(f"[ok]   {name}: no material changes (stamp-only) — no PR")
                continue
            run(["git", "-C", str(wt), "commit", "-q", "-m",
                 f"chore(kit): update from kit {rec} -> {kit_head}\n\nAutomated by kit-propagate; "
                 f"update.sh + policy patches; hook compile+import gate passed."])
            pushed = run([SAFE_PUSH, "-C", str(wt), "-u", "origin", branch],
                         check=False, timeout=NETWORK_TIMEOUT)
            if pushed is None or pushed.returncode != 0:
                # A repo can refuse its own push — mylantite runs its full test
                # suite as a pre-push gate, and that suite is intermittently
                # red. That is this repo's business, not a reason to abandon
                # the repos queued behind it.
                detail = (pushed.stderr or pushed.stdout or "").strip().splitlines() if pushed else []
                # git's LAST stderr line is always the generic "failed to push
                # some refs" trailer; the reason (a pre-push hook's message, a
                # non-fast-forward) sits above it. Reporting detail[-1] told us
                # nothing on every failure it ever printed (2026-08-30).
                noise = ("To ", "error: failed to push some refs", "hint:", "remote:")
                lines = [ln for ln in detail if ln.strip()]
                useful = [ln for ln in lines if not ln.strip().startswith(noise)]
                why = " | ".join((useful or lines)[-3:]) or "no output"
                log(f"[FAIL] {name}: push refused — {why}")
                continue
            coords = repo_coords(repo)
            url = create_pr(*coords, branch, base, rec, kit_head, changed) if coords else "?"
            log(f"[PR]   {name}: {url} ({len(changed)} file(s))")
        except Exception as e:
            # Belt and braces. Every step above that can fail is handled, but a
            # NEW step added later must not be able to take the whole run down:
            # one repo's problem is one repo's problem. #31 claimed to fix this
            # by turning a TimeoutExpired into a RuntimeError — which is still
            # fatal under check=True, so the run kept dying (2026-08-29,
            # mylantite, taking grade5/meritick/homelab with it).
            log(f"[FAIL] {name}: {type(e).__name__}: {str(e)[:200]}")
            continue
        finally:
            run(["git", "-C", repo, "worktree", "remove", "--force", str(wt)], check=False)
            # Drop the transient local branch too — origin keeps it while a PR is
            # open (the pending-PR skip above checks origin/<branch>, not local),
            # so leaving it locally only created daily churn for prune-stale-branches.
            run(["git", "-C", repo, "branch", "-D", branch], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
